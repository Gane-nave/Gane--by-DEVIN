{
  "entities": {
    "User": {
      "title": "User",
      "description": "A registered user of the G.A.N.E system.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "lastLogin": { "type": "timestamp" }
      },
      "required": ["uid", "email"]
    },
    "Incident": {
      "title": "Incident",
      "description": "A reported hazard or event.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["ACCIDENT", "CONSTRUCTION", "HAZARD", "WEATHER"] },
        "severity": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "description": { "type": "string" },
        "timestamp": { "type": "number" },
        "authorUid": { "type": "string" }
      },
      "required": ["id", "type", "severity", "lat", "lng", "timestamp", "authorUid"]
    },
    "MediaGeneration": {
      "title": "MediaGeneration",
      "description": "AI generated media (image, video, music).",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["IMAGE", "VIDEO", "MUSIC"] },
        "url": { "type": "string" },
        "prompt": { "type": "string" },
        "aspectRatio": { "type": "string" },
        "model": { "type": "string" },
        "timestamp": { "type": "number" },
        "authorUid": { "type": "string" }
      },
      "required": ["id", "type", "url", "prompt", "timestamp", "authorUid"]
    },
    "AIChat": {
      "title": "AIChat",
      "description": "A chat session with Gemini.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "authorUid": { "type": "string" },
        "messages": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "role": { "type": "string", "enum": ["user", "model"] },
              "parts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "text": { "type": "string" }
                  }
                }
              },
              "timestamp": { "type": "number" }
            }
          }
        },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "authorUid", "messages", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles."
    },
    "/incidents/{incidentId}": {
      "schema": { "$ref": "#/entities/Incident" },
      "description": "Global incidents reported by users."
    },
    "/media_generations/{mediaId}": {
      "schema": { "$ref": "#/entities/MediaGeneration" },
      "description": "Media generated by users."
    },
    "/ai_chats/{chatId}": {
      "schema": { "$ref": "#/entities/AIChat" },
      "description": "Chat history for users."
    }
  }
}
