/target
**/*.rs.bk
*.swp
*.swo
.DS_Store

# Never commit archives / release bundles
*.zip
*.tar
*.tar.gz
*.tgz

# Binary / rendered documents belong outside source control
*.pdf

# Node / front-end build artefacts (shared rules for frontend/ + apps/*)
**/node_modules
**/dist
**/.vite
**/coverage
**/.env
**/.env.local
**/.env.*.local

# Playwright / test artefacts
**/test-results
**/playwright-report
**/blob-report
**/.nyc_output

# Next / Vite caches
**/.next
**/.turbo
**/.cache

# OS / editor
.idea
.vscode
*.log
